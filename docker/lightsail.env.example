# Copy to .env.lightsail on the server; never commit the populated file.
POSTGRES_DB=lostparty
POSTGRES_PASSWORD=REPLACE_ADMIN_PASSWORD
APP_DB_PASSWORD=REPLACE_APP_PASSWORD
# Set to the exact checked-out git commit before building.
RELEASE_TAG=REPLACE_SOURCE_COMMIT
# Confirm this audience with the existing Flutter Google sign-in configuration.
GOOGLE_CLIENT_ID=574337852234-vdkvdobbq8es2rdpumc1icqt6ja3a3cr.apps.googleusercontent.com
GOOGLE_AZP_ALLOWLIST=
# Reserved placeholder permits private DB/API setup; do not enable public yet.
# Use a controlled public DNS hostname, without https:// or a path.
API_DOMAIN=api.example.invalid
