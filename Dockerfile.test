# Build the checked-out source; never inherit a mutable development API image.
FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
COPY requirements-dev.txt requirements.txt ./
RUN pip install --no-cache-dir -r requirements-dev.txt && useradd --uid 10001 --create-home appuser
COPY --chown=appuser:appuser app ./app
COPY --chown=appuser:appuser alembic ./alembic
COPY --chown=appuser:appuser alembic.ini pytest.ini ./
COPY --chown=appuser:appuser tests ./tests
COPY --chown=appuser:appuser openapi ./openapi
COPY --chown=appuser:appuser docs ./docs
COPY --chown=appuser:appuser scripts ./scripts
USER appuser
CMD ["python", "scripts/isolated_checks.py", "legacy"]
