# Build the checked-out source; never inherit a mutable development API image.
FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
COPY requirements.txt requirements-dev.txt requirements.in requirements-dev.in ./
COPY scripts/check_dependencies.py ./scripts/check_dependencies.py
RUN python scripts/check_dependencies.py && pip install --no-cache-dir --require-hashes --only-binary=:all: -r requirements-dev.txt \
    && pip check && python scripts/check_dependencies.py --installed test \
    && useradd --uid 10001 --create-home appuser
COPY --chown=appuser:appuser app ./app
COPY --chown=appuser:appuser alembic ./alembic
COPY --chown=appuser:appuser alembic.ini pytest.ini ./
COPY --chown=appuser:appuser tests ./tests
COPY --chown=appuser:appuser openapi ./openapi
COPY --chown=appuser:appuser docs ./docs
COPY --chown=appuser:appuser scripts ./scripts
USER appuser
CMD ["python", "scripts/isolated_checks.py", "legacy"]
