FROM lostparty-backend-api:latest
USER root
COPY requirements-dev.txt requirements.txt ./
RUN pip install --no-cache-dir -r requirements-dev.txt
COPY tests ./tests
COPY openapi ./openapi
COPY docs/features/recruitment/artifacts/issue13-two-cycle.full.openapi.json ./docs/features/recruitment/artifacts/issue13-two-cycle.full.openapi.json
COPY pytest.ini ./pytest.ini
USER appuser
CMD ["pytest", "-q", "-p", "no:cacheprovider"]
