          "$ref": "#/$defs/BOrigin"
        },
        "target_cycle_key": {
          "$ref": "#/$defs/CycleKey"
        },
        "target_generation": {
          "$ref": "#/$defs/Version"
        },
        "comparison": {
          "anyOf": [
            {
              "$ref": "#/$defs/BPowerComparison"
            },
            {
              "type": "null"
            }
          ]
        },
        "analysis": {
          "anyOf": [
