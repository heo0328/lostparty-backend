    "ApplicationDisplayItem": {
      "properties": {
        "application_id": {
          "type": "string",
          "format": "uuid",
          "title": "Application Id"
        },
        "room_id": {
          "type": "string",
          "format": "uuid",
          "title": "Room Id"
        },
        "revision": {
          "type": "integer",
          "maximum": 2147483647.0,
          "minimum": 1.0,
          "title": "Revision"
        },
        "state": {
          "type": "string",
          "title": "State"
        },
        "created_at": {
          "type": "string",
