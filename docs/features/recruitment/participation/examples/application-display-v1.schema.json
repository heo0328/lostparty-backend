{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lostparty:application-display:proposal-1",
  "title": "Application display proposal1; authored contract, not runtime API",
  "oneOf": [
    {
      "$ref": "#/$defs/ApplicationDisplayPageResponse"
    },
    {
      "$ref": "#/$defs/ApplicationDisplayDetailResponse"
    },
    {
      "$ref": "#/$defs/Error"
    }
  ],
  "$defs": {
    "Version": {
      "type": "integer",
      "maximum": 2147483647.0,
      "minimum": 1.0,
      "title": "Version",
      "description": "Strict integer at server; booleans/floats rejected."
    },
    "ApplicationDisplayAnalysis": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "maximum": 2147483647.0,
          "minimum": 1.0,
          "title": "Version",
          "description": "Strict integer at server; booleans/floats rejected."
        },
        "saved_at": {
          "type": "string",
          "format": "date-time"
        },
        "analyzed_at": {
          "type": "string",
          "format": "date-time"
        },
        "integrity_status": {
          "type": "string",
          "enum": [
            "clean",
            "review",
            "error",
            "unavailable"
          ]
        },
        "issues": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/BAnalysisIssue"
          }
        }
      },
      "required": [
        "version",
        "saved_at",
        "analyzed_at",
        "integrity_status",
        "issues"
      ],
      "additionalProperties": false
    },
    "Severity": {
      "type": "string",
      "enum": [
        "warning",
        "error"
      ],
      "title": "Severity"
    },
    "BAnalysisIssue": {
      "properties": {
        "code": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Z0-9_]+$",
          "title": "Code"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "code",
        "severity"
      ],
      "title": "BAnalysisIssue"
    },
    "SelectedRole": {
      "type": "string",
      "enum": [
        "dealer",
        "support"
      ],
      "title": "SelectedRole"
    },
    "State8": {
      "type": "string",
      "enum": [
        "unrestricted",
        "missing",
        "below",
        "meets"
      ],
      "title": "State8"
    },
    "BPowerComparison": {
      "properties": {
        "selected_role": {
          "$ref": "#/$defs/SelectedRole"
        },
        "requirement": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 32,
              "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
            },
            {
              "type": "null"
            }
          ],
          "title": "Requirement"
        },
        "actual": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 32,
              "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
            },
            {
              "type": "null"
            }
          ],
          "title": "Actual"
        },
        "state": {
          "$ref": "#/$defs/State8"
        },
        "source": {
          "type": "string",
          "const": "flutter_analysis",
          "title": "Source"
        },
        "trust": {
          "type": "string",
          "const": "client_submitted",
          "title": "Trust"
        },
        "current_summary_version": {
          "type": "integer",
          "maximum": 2147483647.0,
          "minimum": 1.0,
          "title": "Current Summary Version"
        },
        "success_summary_version": {
          "anyOf": [
            {
              "type": "integer",
              "maximum": 2147483647.0,
              "minimum": 1.0
            },
            {
              "type": "null"
            }
          ],
          "title": "Success Summary Version"
        },
        "power_revision": {
          "type": "integer",
          "maximum": 2147483647.0,
          "minimum": 1.0,
          "title": "Power Revision"
        },
        "observed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observed At"
        },
        "success_saved_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ],
          "title": "Success Saved At"
        },
        "success_issues": {
          "items": {
            "$ref": "#/$defs/BAnalysisIssue"
          },
          "type": "array",
          "title": "Success Issues"
        },
        "current_issues": {
          "items": {
            "$ref": "#/$defs/BAnalysisIssue"
          },
          "type": "array",
          "title": "Current Issues"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "selected_role",
        "requirement",
        "actual",
        "state",
        "source",
        "trust",
        "current_summary_version",
        "success_summary_version",
        "power_revision",
        "observed_at",
        "success_saved_at",
        "success_issues",
        "current_issues"
      ],
      "title": "BPowerComparison"
    },
    "BOrigin": {
      "properties": {
        "scope": {
          "anyOf": [
            {
              "$ref": "#/$defs/Scope1"
            },
            {
              "type": "null"
            }
          ]
        },
        "group_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ],
          "title": "Group Id"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "scope",
        "group_id"
      ],
      "title": "BOrigin"
    },
