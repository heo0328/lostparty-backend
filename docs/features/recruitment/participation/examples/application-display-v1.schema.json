        "application_id",
        "room_id",
        "revision",
        "state",
        "created_at",
        "expires_at",
        "ended_at",
        "character_id",
        "selected_role",
        "display",
        "admission_origin",
        "target_cycle_key",
        "target_generation",
        "comparison",
        "analysis",
        "display_reason"
