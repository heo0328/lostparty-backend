                }
              }
            }
          }
        ]
      },
      "CandidatePage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "group_id",
          "filter_context_token",
          "scope_digest",
          "candidate_token",
          "evaluated_at",
          "groups",
          "next_cursor"
        ],
        "properties": {
          "group_id": {
            "type": "string",
            "format": "uuid"
          },
          "filter_context_token": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "scope_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "candidate_token": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "evaluated_at": {
            "type": "string",
            "format": "date-time"
          },
          "groups": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CandidateMemberChunk"
            },
            "maxItems": 100
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "SearchCandidateBinding": {
        "type": "object",
        "description": "Addition to the existing search request; not a complete search body. Absent preserves legacy behavior; explicit null is invalid.",
        "properties": {
          "group_character_candidates_token": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          }
        },
        "additionalProperties": false
      },
      "GameErrorOut": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/GameErrorDetail"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "error"
        ],
        "title": "GameErrorOut"
      },
      "GameErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          },
          "retry_after_seconds": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Retry After Seconds"
          },
          "retry_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retry At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "GameErrorDetail"
      }
    }
  }
}
