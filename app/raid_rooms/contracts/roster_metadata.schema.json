{
  "RosterIssueOwnCycle": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "target_cycle_key": {
        "type": "string",
        "format": "date"
      },
      "has_issues": {
        "type": "boolean"
      },
      "affected_room_count": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483647
      }
    },
    "required": [
      "target_cycle_key",
      "has_issues",
      "affected_room_count"
    ]
  },
  "RosterIssueSummary": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "profile": {
        "type": "string",
        "const": "roster-character-issues-1"
      },
      "current_cycle_key": {
        "type": "string",
        "format": "date"
      },
      "next_cycle_key": {
        "type": "string",
        "format": "date"
      },
      "has_issues": {
        "type": "boolean"
      },
      "affected_room_count": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483647
      },
      "affected_target_count": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483647
      },
      "cycles": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/RosterIssueOwnCycle"
        },
        "minItems": 2,
        "maxItems": 2
      },
      "evaluated_at": {
        "type": "string",
        "format": "date-time"
      },
      "issues_revision": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "required": [
      "profile",
      "current_cycle_key",
      "next_cycle_key",
      "has_issues",
      "affected_room_count",
      "affected_target_count",
      "cycles",
      "evaluated_at",
      "issues_revision"
    ]
  },
  "RosterIssueTargetSummary": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "target_cycle_key": {
        "type": "string",
        "format": "date"
      },
      "state": {
        "type": "string",
        "enum": [
          "ready",
          "not_authorized"
        ]
      },
      "has_issues": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      },
      "affected_participant_count": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "target_cycle_key",
      "state",
      "has_issues",
      "affected_participant_count"
    ],
    "allOf": [
      {
        "if": {
          "properties": {
            "state": {
              "const": "not_authorized"
            }
          }
        },
        "then": {
          "properties": {
            "has_issues": {
              "type": "null"
            },
            "affected_participant_count": {
              "type": "null"
            }
          }
        },
        "else": {
          "properties": {
            "has_issues": {
              "type": "boolean"
            },
            "affected_participant_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            }
          }
        }
      }
    ]
  },
