            "type": "null"
          }
        ]
      }
    },
    "required": [
      "code",
      "room_id",
      "target_cycle_key",
      "room_cycle_id",
      "target_generation",
      "cycle_member_id",
      "character_id",
      "character_name",
      "assignment_ids",
      "observed_at",
      "registration_id"
