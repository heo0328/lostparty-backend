    "required": [
      "state",
      "observed_at"
    ],
    "allOf": [
      {
        "if": {
          "properties": {
            "state": {
              "const": "unknown"
            }
          }
        },
        "then": {
          "properties": {
            "observed_at": {
              "type": "null"
            }
          }
        },
        "else": {
          "properties": {
