{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {"safe": {"()": "app.core.observability.SafeJsonFormatter"}},
  "handlers": {
    "console": {"class": "logging.StreamHandler", "stream": "ext://sys.stdout", "formatter": "safe"},
    "discard": {"class": "logging.NullHandler"}
  },
  "root": {"handlers": ["console"], "level": "WARNING"},
  "loggers": {
    "lostparty": {"handlers": ["console"], "level": "INFO", "propagate": false},
    "uvicorn": {"handlers": ["console"], "level": "INFO", "propagate": false},
    "uvicorn.error": {"handlers": ["console"], "level": "INFO", "propagate": false},
    "uvicorn.access": {"handlers": ["discard"], "propagate": false}
  }
}
